# ================================================================
# JAYSHREE REALTY - Environment Configuration Template
# Copy this file to .env and fill in your values
# ================================================================

# ── Server & Application ─────────────────────────────────────────
PORT=5000
NODE_ENV=production
FRONTEND_URL=https://jayshreerealty.com
BACKEND_URL=https://jayshreerealty.com
CLIENT_URL=https://jayshreerealty.com

# ── Supabase Database ────────────────────────────────────────────
# Get these from: https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
DATABASE_URL=postgresql://postgres:your_password@db.your-project-ref.supabase.co:5432/postgres

# Supabase Personal Access Token (for automated migrations)
# Get from: https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=sbp_92a9261134ec39054fdc852eba433969c4f325cd

# ── Authentication & Session ─────────────────────────────────────
# Use a long random string for JWT_SECRET (min 32 chars)
JWT_SECRET=your_long_random_jwt_secret_key_here_min_32_chars
SESSION_SECRET=your_long_random_session_secret_key_here
ADMIN_USER=admin@jayshreerealty
ADMIN_PASS=your_secure_admin_password_here

# ── Gmail SMTP (for lead email notifications) ────────────────────
# Requires a Gmail App Password (NOT your regular Gmail password)
# Setup: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
RECEIVER_EMAIL=your_notification_receiver@gmail.com

# ── Google Services (optional) ───────────────────────────────────
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
